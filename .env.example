# Copy to .env (never commit .env) and fill in.

PORT=3000

# Private dashboard at /admin. Leave ADMIN_PASSWORD empty and the dashboard is disabled.
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-passphrase

# OPTIONAL instant email (via resend.com). Both must be set to enable.
NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=
EMAIL_FROM=Lets See <onboarding@resend.dev>

# OPTIONAL webhook (Discord/Slack/Zapier/etc). Receives JSON with "text" and "response".
WEBHOOK_URL=
